DATABASE_URL=mongodb://127.0.0.1:27017/mern_discord
JWT_KEY=your_jwt_secret

# Comma-separated list of frontend origins (browser URL). Add your LAN URL for mobile testing, e.g.:
# ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173
ORIGIN=http://localhost:5173

# Cookie Secure flag: on HTTP (local/LAN) must be false or mobile browsers will drop the JWT cookie.
# Set JWT_COOKIE_SECURE=true when the API is served over HTTPS (production).
# Default: false in development, true in production (override with JWT_COOKIE_SECURE=false if needed).
JWT_COOKIE_SECURE=

PORT=3001

# In-app browsers (Messenger, Facebook) may drop cross-site cookies on reload. Sign-in also returns `token`;
# the SPA stores it (localStorage + sessionStorage backup) and sends Authorization: Bearer (server accepts cookie OR Bearer).

# VNPay Sandbox — https://sandbox.vnpayment.vn/apis/docs/
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/api/shop/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3001/api/shop/payments/vnpay/ipn
